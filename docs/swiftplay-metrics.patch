 """
 
 from __future__ import annotations
+
+
+# --- game-mode classes -----------------------------------------------------
+#
+# Swiftplay replays carry the same game-state and player-state FIELDS on
+# differently named classes: Swiftplay_EoRCredits_GameState_C and
+# Swiftplay_EoRCredits_PlayerState_C. Matching the Bomb class name alone
+# silently produces an empty metrics document for them.
+GAME_STATE_CLASSES = ("BombGameState", "Swiftplay_EoRCredits_GameState")
+PLAYER_STATE_CLASSES = ("BombPlayerState", "Swiftplay_EoRCredits_PlayerState")
+
+
+def is_game_state(path):
+    return any(c in (path or "") for c in GAME_STATE_CLASSES)
+
+
+def is_player_state(path):
+    return any(c in (path or "") for c in PLAYER_STATE_CLASSES)
 
