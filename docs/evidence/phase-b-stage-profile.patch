+
+
+#[derive(Default)]
+struct ColumnProfile {
+    batches: u64,
+    rows: u64,
+    build_ns: u128,
+    dict_values: u64,
+    dict_runs: u64,
+    hash_bytes: u64,
+    run_hash_bytes: u64,
+}
+
+thread_local! {
+    static COLUMN_PROFILE: std::cell::RefCell<std::collections::BTreeMap<(&'static str, &'static str), ColumnProfile>> = std::cell::RefCell::new(std::collections::BTreeMap::new());
+}
+
+fn profile_column(row: &'static str, name: &'static str, make: impl FnOnce() -> arrow_array::ArrayRef) -> arrow_array::ArrayRef {
+    use arrow_array::{Array, DictionaryArray, StringArray, types::Int32Type};
+    let started = std::time::Instant::now();
+    let array = make();
+    let elapsed = started.elapsed().as_nanos();
+    COLUMN_PROFILE.with(|profiles| {
+        let mut profiles = profiles.borrow_mut();
+        let profile = profiles.entry((row, name)).or_default();
+        profile.batches += 1;
+        profile.rows += array.len() as u64;
+        profile.build_ns += elapsed;
+        if let Some(dict) = array.as_any().downcast_ref::<DictionaryArray<Int32Type>>() {
+            let strings = dict.values().as_any().downcast_ref::<StringArray>().unwrap();
+            let mut previous = None;
+            for key in dict.keys() {
+                if let Some(key) = key {
+                    let bytes = strings.value(key as usize).len() as u64;
+                    profile.dict_values += 1;
+                    profile.hash_bytes += bytes;
+                    if Some(key) != previous {
+                        profile.dict_runs += 1;
+                        profile.run_hash_bytes += bytes;
+                    }
+                }
+                previous = key;
+            }
+        }
+    });
+    array
+}
+
+pub(crate) fn profile_flush_columns() {
+    COLUMN_PROFILE.with(|profiles| {
+        let profiles = std::mem::take(&mut *profiles.borrow_mut());
+        for ((row, column), p) in profiles {
+            eprintln!("PHASE_PROFILE column {row}.{column} batches={} rows={} build_ns={} dict_values={} dict_runs={} hash_bytes={} run_hash_bytes={}", p.batches, p.rows, p.build_ns, p.dict_values, p.dict_runs, p.hash_bytes, p.run_hash_bytes);
+        }
+    });
+}
