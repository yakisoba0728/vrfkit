+
+fn profile_column(
+    row: &'static str,
+    column: &'static str,
+    build: impl FnOnce() -> arrow_array::ArrayRef,
+) -> arrow_array::ArrayRef {
+    let start = std::time::Instant::now();
+    let result = build();
+    let ns = start.elapsed().as_nanos();
+    let bytes = result
+        .as_any()
+        .downcast_ref::<arrow_array::BinaryArray>()
+        .map_or(0, |array| array.value_data().len());
+    COLUMN_PROFILES.with(|profiles| {
+        let mut profiles = profiles.borrow_mut();
+        let item = profiles.entry((row, column)).or_default();
+        item.0 += 1;
+        item.1 += result.len();
+        item.2 += ns;
+        item.3 += bytes;
+    });
+    result
+}
