+impl Drop for SampledMoves {
+    fn drop(&mut self) {
+        let mut samples = self.samples.borrow_mut();
+        samples.sort_unstable();
+        if !samples.is_empty() {
+            eprintln!("PHASE_PROFILE moves calls={} samples={} total_sample_ns={} median_sample_ns={} p95_sample_ns={}", self.calls.get(), samples.len(), samples.iter().sum::<u128>(), samples[samples.len()/2], samples[samples.len()*95/100]);
