+struct MoveTimer(Option<std::time::Instant>);
+impl MoveTimer {
+    fn start() -> Self {
+        let selected = SAMPLED_MOVES.with(|p| {
+            let call = p.calls.get();
+            p.calls.set(call + 1);
+            call & 1023 == 0
+        });
+        Self(selected.then(std::time::Instant::now))
+    }
+}
+impl Drop for MoveTimer {
+    fn drop(&mut self) {
+        if let Some(start) = self.0 {
+            let ns = start.elapsed().as_nanos();
+            SAMPLED_MOVES.with(|p| p.samples.borrow_mut().push(ns));
+        }
+    }
